{
  "name": "blackstone-carry-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vinext/dist/cli.js dev",
    "dev:vinext": "vinext dev",
    "build": "vinext build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/vinext/dist/cli.js start --hostname 127.0.0.1",
    "test": "node evals/run-evals.mjs && node --test evals/*.test.mjs",
    "check": "npm run test && npm run build",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "type": "module",
  "allowScripts": {
    "workerd@1.20260831.1": true,
    "esbuild@0.28.1": true
  }
}
